{
  "name": "calendar-checker",
  "description": "A local-first multi-account Google Calendar Chrome extension.",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extension": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check && npm run build && npm run test:release && npm run verify:build",
    "extension:id": "node scripts/extension-id.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:release": "node --test scripts/verify-build.test.mjs",
    "release:local": "npm run check && npm run test:extension && npm run zip && node scripts/package-release.mjs",
    "prebuild": "node scripts/generate-notices.mjs",
    "prezip": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temporal-polyfill": "1.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
