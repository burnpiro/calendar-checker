# Public OAuth client identifier, NOT a client secret.
# Create a Chrome Extension OAuth client using: npm run extension:id
WXT_GOOGLE_CLIENT_ID=

# Optional Web application client for an explicit multi-account chooser.
# Authorized redirect: https://<extension-id>.chromiumapp.org/
# No client secret is used. See docs/MULTI-ACCOUNT-SETUP.md.
WXT_GOOGLE_WEB_CLIENT_ID=
